{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-stdlib=libc++",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler: /usr/bin/clang++"
        },
        {
            "type": "shell",
            "label": "LaTeX: build resume",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/resume"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "latexmk via resume/Makefile -> resume/resume.pdf"
        },
        {
            "type": "shell",
            "label": "LaTeX: watch resume",
            "command": "make watch",
            "options": {
                "cwd": "${workspaceFolder}/resume"
            },
            "problemMatcher": [],
            "isBackground": true,
            "detail": "rebuild resume.pdf on every save (Ctrl-C to stop)"
        }
    ]
}
